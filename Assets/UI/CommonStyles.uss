:root {
    -unity-font-definition: url("project://database/Assets/Plugins/Fonts/Lato-Regular.ttf?fileID=12800000&guid=aee713c71c7fdc641a7b5222f22bc898&type=3#Lato-Regular");
}

.text-headline {
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/Plugins/Fonts/Lato-Black.ttf?fileID=12800000&guid=882dec2489fc2944d9467942e673ba17&type=3#Lato-Black");
}

.common__rotate-clockwise-button {
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/Plugins/Icons/icon_arrow_rotate.png?fileID=2800000&guid=fa4f6b90d48544349b42773241f324b9&type=3#icon_arrow_rotate");
}

.common__rotate-counter-clockwise-button {
    width: 50px;
    height: 50px;
    background-image: url("project://database/Assets/Plugins/Icons/icon_arrow_rotate.png?fileID=2800000&guid=fa4f6b90d48544349b42773241f324b9&type=3#icon_arrow_rotate");
    rotate: 180deg;
}

.common__mute-icon {
    background-image: url("project://database/Assets/Plugins/Icons/icon_sound.png?fileID=2800000&guid=7782126fc0d87f74f96c5f07febc7f72&type=3#icon_sound");
}

.common__unmute-icon {
    background-image: url("project://database/Assets/Plugins/Icons/icon_sound_disabled.png?fileID=2800000&guid=2a578146b562abb4f8e09a10260d120d&type=3#icon_sound_disabled");
}

.common__destroy-button {
    background-image: url("project://database/Assets/Plugins/Icons/icon_skull.png?fileID=2800000&guid=c19acf9abdc0bd140aa802aa397fcb54&type=3#icon_skull");
}

.common__menu-button {
    width: 62px;
    height: 62px;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}
